PORT=9090
DATA_DIR=./data
CONFIG_DIR=./config
# ENABLE_UPLOAD_FORM=true
# JWT_SECRET=

# Global token that grants upload, delete, and download access across all projects.
# Acts as a superuser key — accepted anywhere a per-project token would be.
# Does NOT change auth requirements of individual projects (open projects stay open).
# GLOBAL_TOKEN=

# Comma-separated list of root-level filenames to serve from STATIC_DIR (without
# project routing). Typical values: favicon.ico, robots.txt. Exact filenames, no globs.
# ROOT_FILES=favicon.ico,robots.txt

# Enable structured JSON-line logs to stderr.
# Strongly recommended in production — without it, request errors are invisible.
# (docker-compose enables it by default.)
# LOG=true

# On startup, remove stale upload-in-progress files (*.tmp_<uuid>) older than this many ms.
# Default: 3600000 (1 hour). Set 0 to disable.
# TMP_SWEEP_MAX_AGE_MS=3600000

# Server-level fallback byte cap for a single uploaded file, applied when the
# project config sets no maxFileSize. Guards against a streaming upload filling
# the disk. Default: 2147483648 (2 GiB). Set 0 for unlimited.
# MAX_UPLOAD_SIZE=2147483648

# Abort an upload when no body chunk arrives for this many ms (guards stalled
# slow-drip connections). Default: 60000. Set 0 to disable.
# UPLOAD_IDLE_TIMEOUT_MS=60000

# Docker: UID/GID of the host user for correct file ownership in mounted volumes.
# Run `id -u` and `id -g` to find your values.
# PUID=1000
# PGID=1000

# CDN integration (optional). Set CDN_PROVIDER to enable.
# CDN_PROVIDER=cloudflare
# CDN_CACHE_PURGE_URL_PREFIX=https://cdn.example.com
# CDN_CACHE_MAX_AGE=60
# CDN_CACHE_S_MAXAGE=604800
# CDN_STALE_WHILE_REVALIDATE=86400

# Cloudflare-specific (required when CDN_PROVIDER=cloudflare)
# CF_ZONE_ID=
# CF_API_TOKEN=
